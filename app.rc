#include <windows.h>
1 RT_MANIFEST "app.manifest"
1 ICON "assets/app.ico"
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "080404B0"
  BEGIN
   VALUE "FileDescription", "轻扫 QuickQR - 本地二维码识别\0"
   VALUE "ProductName", "轻扫 QuickQR\0"
   VALUE "FileVersion", "1.0.0\0"
   VALUE "LegalCopyright", "QuickQR contributors\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x804, 1200
 END
END
